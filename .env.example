# Where MineShell keeps its database, instance directories and unit env files.
# Default: $XDG_DATA_HOME/mineshell, i.e. ~/.local/share/mineshell
MINESHELL_DATA=/srv/mineshell

# Name of the systemd template unit MineShell manages. Instances become
# minecraft@<instance-id>.service
MINESHELL_UNIT_PREFIX=minecraft

# Require a login before anything is reachable. Strongly recommended even on a
# LAN. Set to "off" to disable entirely (single-user, trusted network only).
MINESHELL_AUTH=on

# Optional CurseForge API key. Without it, CurseForge/FTB browsing falls back to
# the public modpacks.ch proxy and direct-download links may be unavailable.
CURSEFORGE_API_KEY=

# Port for the production server (npm start). HOST=127.0.0.1 answers only on
# this machine: behind a reverse proxy, or with Tailscale serve in front.
PORT=3000
HOST=0.0.0.0

# Behind a reverse proxy only (docs/DEPLOYMENT.md, Remote access): the client's
# address for the login throttle, from the header the proxy sets. XFF_DEPTH is
# the number of proxies in front. Never without a proxy that sets the header.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# Largest request the production server accepts (npm start). The default
# (512K) refuses mod jar, modpack and world uploads; worlds run to gigabytes.
# Dev (npm run dev) has no limit.
BODY_SIZE_LIMIT=Infinity
