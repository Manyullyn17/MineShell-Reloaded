#!/usr/bin/env bash
# Type check, then the whole test suite (about 7 s). Not Vitest --changed: on
# the shared project (isolate: false) it now and then ran files without
# tests/setup.ts's mocks of node:child_process and node:dns/promises, so tests
# failed that pass in any order on their own, and it saved about a second. CI
# runs everything anyway; this only catches it before the push. Skip with
# `git push --no-verify`. Enabled per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
pushing=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	[[ "$local_sha" == "$zero" ]] && continue # deleting a ref
	pushing=1
done
[[ $pushing == 0 ]] && exit 0

npm run check
npm test
